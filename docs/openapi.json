    "/transactions/{tx_id}/cancel": {
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "Débloquer une transaction pending",
        "description": "Force une transaction restée **pending** à **cancelled** (de votre app).\n\nSert à débloquer une transaction coincée (ex: serveur interrompu avant le\nverdict) qui empêcherait un nouveau paiement sur le même numéro\n(`409 pending_exists`). N'agit que sur une ligne encore `pending` de votre\napp — ne réécrit jamais un verdict déjà acté.",
        "operationId": "cancel_transaction_transactions__tx_id__cancel_post",
        "parameters": [
          {
            "name": "tx_id",
            "in": "path",
            "required": true,
            "schema": {
