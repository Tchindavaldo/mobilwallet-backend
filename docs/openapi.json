          "id",
          "app_id",
          "env",
          "api_key",
          "key_prefix",
          "last_four"
        ],
        "title": "ApiKeyCreated",
        "description": "Réponse à la création d'une clé : la clé en clair n'est montrée QU'ICI."
      },
